# Copy to the VPS as Gorest/.env.prod (never commit real secrets).

GOREST_IMAGE=ghcr.io/chuuch/gorest:latest

GOREST_APP_NAME=Flourish
GOREST_APP_ENVIRONMENT=production
GOREST_APP_PUBLIC_URL=https://app.example.com

GOREST_SERVER_HOST=0.0.0.0
GOREST_SERVER_PORT=8080
GOREST_SERVER_READ_TIMEOUT=10s
GOREST_SERVER_WRITE_TIMEOUT=10s
GOREST_SERVER_IDLE_TIMEOUT=60s
GOREST_SERVER_SHUTDOWN_TIMEOUT=10s

GOREST_DATABASE_HOST=postgres
GOREST_DATABASE_PORT=5432
GOREST_DATABASE_USER=gorest
GOREST_DATABASE_PASSWORD=change-me-long-random
GOREST_DATABASE_NAME=gorest
GOREST_DATABASE_SSL_MODE=disable
GOREST_DATABASE_MAX_CONNECTIONS=20
GOREST_DATABASE_MIN_CONNECTIONS=2
GOREST_DATABASE_MAX_CONN_LIFETIME=1h
GOREST_DATABASE_MAX_CONN_IDLE_TIME=30m
GOREST_DATABASE_HEALTH_CHECK_PERIOD=1m

GOREST_AUTH_ACCESS_TOKEN_SECRET=change-me-32chars-minimum-access
GOREST_AUTH_REFRESH_TOKEN_SECRET=change-me-32chars-minimum-refresh
GOREST_AUTH_ACCESS_TOKEN_TTL=15m
GOREST_AUTH_REFRESH_TOKEN_TTL=720h
GOREST_AUTH_INVITE_TTL=168h
GOREST_AUTH_RESET_TTL=1h
GOREST_AUTH_ISSUER=flourish
GOREST_AUTH_BCRYPT_COST=12
GOREST_AUTH_COOKIE_SECURE=true

GOREST_CORS_ALLOWED_ORIGINS=https://app.example.com

# Cloudflare R2 (S3-compatible). Create bucket + API token in CF dashboard.
# Account ID appears in the R2 S3 API URL.
GOREST_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
GOREST_STORAGE_PUBLIC_ENDPOINT=https://files.example.com
GOREST_STORAGE_REGION=auto
GOREST_STORAGE_BUCKET=flourish-prod
GOREST_STORAGE_ACCESS_KEY=<r2_access_key_id>
GOREST_STORAGE_SECRET_KEY=<r2_secret_access_key>
GOREST_STORAGE_USE_PATH_STYLE=false
GOREST_STORAGE_PRESIGN_TTL=15m

GOREST_LOGGER_LEVEL=info
GOREST_LOGGER_FORMAT=json
GOREST_LOGGER_ADD_SOURCE=false

# Resend — verify app.example.com (or example.com) first; SPF/DKIM via Cloudflare DNS.
GOREST_MAILER_DRIVER=resend
GOREST_MAILER_FROM=Flourish <noreply@example.com>
GOREST_MAILER_API_KEY=re_xxxxxxxx
GOREST_MAILER_API_URL=https://api.resend.com/emails

GRAFANA_ADMIN_PASSWORD=change-me-grafana
